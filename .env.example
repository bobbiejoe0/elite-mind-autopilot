# See docs/configuration.md for more information.

# Necessary API Keys
# -------------------

# TikTok Session ID
# Obtain your session ID by logging into TikTok and copying the sessionid cookie.
TIKTOK_SESSION_ID=""

# ImageMagick Binary Path
# Download ImageMagick from https://imagemagick.org/script/download.php
# Leave empty to auto-detect from PATH.
IMAGEMAGICK_BINARY=""

# Pexels API Key
# Register at https://www.pexels.com/api/ to get your API key.
PEXELS_API_KEY=""

# Pixabay API Key (alternative to Pexels; used when PEXELS_API_KEY is empty)
# Get it at https://pixabay.com/api/docs/ while logged in.
PIXABAY_API_KEY=""

# Optional API Keys
# -----------------

# Ollama API Base URL
# Local default: http://localhost:11434
# Docker backend + host Ollama: http://host.docker.internal:11434
OLLAMA_BASE_URL="http://localhost:11434"

# Ollama Model
# Fallback model if frontend did not send a value.
# Pull a model first: ollama pull llama3.1:8b
OLLAMA_MODEL="llama3.1:8b"

# AssemblyAI API Key
# Sign up at https://www.assemblyai.com/ to receive an API key.
ASSEMBLY_AI_API_KEY=""

# Database
# Leave DATABASE_URL empty for local SQLite default.
# In Docker Compose, empty DATABASE_URL uses postgres service fallback.
POSTGRES_DB="moneyprinter"
POSTGRES_USER="moneyprinter"
POSTGRES_PASSWORD="moneyprinter"
DATABASE_URL=""

 

# YouTube upload settings (category 27 = Education, 22 = People & Blogs, 28 = Science & Tech)
YOUTUBE_CATEGORY_ID="28"
# private | unlisted | public (unverified Google API projects can only upload private)
YOUTUBE_PRIVACY_STATUS="private"

# Autopilot: niche used to generate new topics when topics.txt runs out
AUTOPILOT_NICHE="mindset, discipline, self-improvement, stoicism and success habits"
# Script length (paragraphs) for autopilot videos
AUTOPILOT_PARAGRAPHS="3"
# Distinct stock clips per autopilot video (raise for longer videos)
AUTOPILOT_STOCK_VIDEOS="5"
# Daily posting windows for `autopilot.py tick` (one random time inside each window)
AUTOPILOT_WINDOWS="07:00,12:00,17:00"
AUTOPILOT_WINDOW_MINUTES="180"
# TikTok voice(s) for autopilot videos; comma-separated = random pick per video
AUTOPILOT_VOICE="en_us_006"

# Hard cap on script words (~3 spoken words/second); 0 disables
VIDEO_MAX_WORDS="0"

# Spoken outro appended to every video script (leave empty to disable)
VIDEO_CALL_TO_ACTION=""
# Ollama request timeout in seconds (raise on CPU-only machines)
OLLAMA_TIMEOUT="180"

# AI visuals: "stock" (default) or "ai_images" (AI image per scene, falls back to stock)
VISUAL_MODE="stock"
# Providers tried in order: pollinations, cloudflare, local (local needs torch + diffusers)
IMAGE_PROVIDERS="pollinations,cloudflare,local"
# Free key: https://enter.pollinations.ai/keys
POLLINATIONS_API_KEY=""
# Cloudflare Workers AI (free tier): account ID + API token with Workers AI permission
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""

# Text model: "ollama" (local) or "pollinations" (hosted, uses POLLINATIONS_API_KEY; falls back to Ollama)
TEXT_PROVIDER="ollama"

# Optional recurring story character and his fixed look (kept identical in every image prompt)
STORY_CHARACTER=""
STORY_CHARACTER_LOOK=""

# Long-form videos (8-12 min, 1920x1080) on these weekdays, e.g. "mon,wed,fri"; empty disables
AUTOPILOT_LONG_DAYS=""
AUTOPILOT_LONG_WINDOW="14:00"
AUTOPILOT_LONG_WINDOW_MINUTES="240"

# YouTube: synthetic-content disclosure, description footer, playlist for every upload
YOUTUBE_SYNTHETIC_MEDIA=""
YOUTUBE_DESCRIPTION_FOOTER=""
YOUTUBE_PLAYLIST=""
